<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password — YoSACCO</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: #0A2342; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .card { background: #fff; border-radius: 16px; padding: 40px; width: 100%; max-width: 420px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
    .logo { font-size: 24px; font-weight: 800; color: #0A2342; margin-bottom: 8px; }
    .logo span { color: #D35050; }
    h2 { font-size: 20px; margin: 0 0 6px; color: #0A2342; }
    p { color: #666; font-size: 14px; margin: 0 0 20px; }
    .form-group { margin-bottom: 16px; }
    label { font-size: 13px; font-weight: 600; color: #444; display: block; margin-bottom: 6px; }
    input { width: 100%; padding: 10px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; box-sizing: border-box; }
    .btn { width: 100%; padding: 12px; background: #D35050; color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; margin-top: 8px; }
    .alert-success { background: #f0fff4; color: #276749; border: 1px solid #9ae6b4; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; font-size: 14px; }
    .alert-danger { background: #fff5f5; color: #c53030; border: 1px solid #fc8181; border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; font-size: 14px; }
    .back { text-align: center; margin-top: 16px; font-size: 13px; } .back a { color: #0A2342; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">Yo<span>$</span>ACCO</div>
    <h2>Forgot Password</h2>
    <p>Enter your email address and we'll send you a link to reset your password.</p>
    <% if (success) { %><div class="alert-success"><%= success %></div><% } %>
    <% if (error) { %><div class="alert-danger"><%= error %></div><% } %>
    <% if (!success) { %>
    <form method="POST" action="/forgot-password">
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" placeholder="you@sacco.coop" required autofocus>
      </div>
      <button type="submit" class="btn">Send Reset Link</button>
    </form>
    <% } %>
    <div class="back"><a href="/login">← Back to Sign In</a></div>
  </div>
</body>
</html>
