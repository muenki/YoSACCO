<%- include('../partials/head', { title: 'Withdrawal Approvals', activePage: 'approver-withdrawals' }) %>

<% var q = locals.query||{}; %>
<% if(q.success==='approved'){ %><div class="alert alert-success">Withdrawal approved.</div><% } %>
<% if(q.success==='rejected'){ %><div class="alert alert-warning">Withdrawal rejected.</div><% } %>

<h2 class="mb-4">Savings Withdrawal Approvals</h2>

<div class="card p-0">
  <div class="card-header"><h3>Pending Withdrawals</h3></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>#</th><th>Member</th><th>Amount</th><th>Reason</th><th>Date</th><th>CO</th><th>Treas</th><th>Chair</th><th>Actions</th></tr></thead>
      <tbody>
        <% if(!withdrawals.length){ %>
        <tr><td colspan="9" style="text-align:center;padding:20px;color:var(--text-muted);">No pending withdrawal requests.</td></tr>
        <% } %>
        <% withdrawals.forEach(function(w, i){ %>
        <tr>
          <td class="text-sm"><%= i+1 %></td>
          <td><div class="font-semibold text-sm"><%= w.member ? w.member.name : '-' %></div><div class="text-xs text-muted"><%= w.member ? w.member.memberId : '' %></div></td>
          <td class="font-semibold">UGX <%= w.amount.toLocaleString() %></td>
          <td class="text-sm"><%= w.reason||'-' %></td>
          <td class="text-sm"><%= new Date(w.appliedAt).toLocaleDateString() %></td>
          <td><%= w.creditOfficerStatus==='approved'?'✓':w.creditOfficerStatus==='rejected'?'✗':'⏳' %></td>
          <td><%= w.treasurerStatus==='approved'?'✓':w.treasurerStatus==='rejected'?'✗':'⏳' %></td>
          <td><%= w.chairpersonStatus==='approved'?'✓':w.chairpersonStatus==='rejected'?'✗':'⏳' %></td>
          <td>
            <form method="POST" action="/approver/withdrawals/<%= w.id %>/approve" style="display:inline;">
              <button type="submit" class="btn btn-sm btn-success">Approve</button>
            </form>
            <form method="POST" action="/approver/withdrawals/<%= w.id %>/reject" style="display:inline;">
              <input type="hidden" name="reason" value="Rejected">
              <button type="submit" class="btn btn-sm btn-danger">Reject</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>